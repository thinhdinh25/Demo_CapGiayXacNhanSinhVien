# ============================================================================
# CẤU HÌNH ĐĂNG NHẬP GOOGLE OAUTH 2.0 THẬT (Google Identity Services)
# ============================================================================
GOOGLE_CLIENT_ID=
# Đặt thành true nếu chỉ cho phép email đuôi @vnu.edu.vn đăng nhập qua Google
GOOGLE_RESTRICT_VNU_DOMAIN=false
# Danh sách email Google được cấp quyền Admin (phân cách bằng dấu phẩy)
ADMIN_EMAILS=ctsv@vnu.edu.vn,admin@vnu.edu.vn

# ============================================================================
# CẤU HÌNH BỘ HẸN GIỜ NHẮC VIỆC SLA (NON-INTERRUPTING BOUNDARY TIMER)
# ============================================================================
# Mốc thiết kế chuẩn là 4 giờ (14400000 ms); khi chạy thử mặc định 60000 ms (1 phút)
SLA_TIMEOUT_MS=60000
# Hộp thư nhận thông báo nhắc việc quá hạn SLA (cán bộ CTSV & trưởng phòng)
SLA_NOTIFY_EMAIL=ctsv@vnu.edu.vn,truongphong.ctsv@vnu.edu.vn

# ============================================================================
# CẤU HÌNH KẾT NỐI CAMUNDA 8 (ZEEBE)
# ============================================================================
# Bỏ comment 2 dòng dưới khi chạy kèm container Zeebe (docker compose up -d zeebe)
# ZEEBE_ADDRESS=localhost:26500
# CAMUNDA_SECURE_CONNECTION=false

# ============================================================================
# CẤU HÌNH GỬI EMAIL BẢN ĐIỆN TỬ & NHẮC VIỆC (NODEMAILER SMTP / GAS)
# ============================================================================
# EMAIL_OVERRIDE_TO=hop_thu_thu_nghiem@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM="Phòng CTSV - Trường ĐH Công nghệ, ĐHQGHN <your_email@gmail.com>"
